// Scene 1: Earth Launch Base

float cloudA = -180;
float cloudB = 330;
float cloudC = 760;

float wind = 0.5;
float windClock = 0;


void setup() {
  size(1100, 700);
  smooth(8);
}


void draw() {
  updateWorld();

  drawSky();
  drawSun();

  drawCloud(cloudA, 125, 1.0);
  drawCloud(cloudB, 205, 0.62);
  drawCloud(cloudC, 105, 0.82);

  drawLandscape();
  drawFence();
  drawRoad();
  drawControlRoom();
  drawLaunchTower();
  drawLaunchPad();
  drawWindSock();
  drawGrass();
  drawInterface();
}


// =====================================
// UPDATE ENVIRONMENT
// =====================================

void updateWorld() {
  windClock = windClock + 0.008;

  wind = map(noise(windClock), 0, 1, 0.25, 1.35);

  cloudA = cloudA + 0.45 * wind;
  cloudB = cloudB + 0.28 * wind;
  cloudC = cloudC + 0.36 * wind;

  if (cloudA > width + 170) {
    cloudA = -200;
  }

  if (cloudB > width + 150) {
    cloudB = -180;
  }

  if (cloudC > width + 170) {
    cloudC = -210;
  }
}


// =====================================
// SKY
// =====================================

void drawSky() {
  for (int y = 0; y < 500; y++) {
    float amount = map(y, 0, 500, 0, 1);

    color topSky = color(32, 145, 225);
    color bottomSky = color(183, 224, 247);

    stroke(lerpColor(topSky, bottomSky, amount));
    line(0, y, width, y);
  }

  noStroke();
}


// =====================================
// SUN
// =====================================

void drawSun() {
  noStroke();

  for (int diameter = 150; diameter > 70; diameter -= 15) {
    fill(255, 220, 80, 8);
    ellipse(920, 100, diameter, diameter);
  }

  fill(255, 222, 74);
  ellipse(920, 100, 68, 68);
}


// =====================================
// CLOUDS
// =====================================

void drawCloud(float x, float y, float cloudSize) {
  noStroke();

  // Cloud shadow
  fill(170, 205, 220, 55);
  ellipse(x + 5, y + 13, 150 * cloudSize, 44 * cloudSize);

  // White cloud sections
  fill(255, 250);

  ellipse(x, y, 130 * cloudSize, 45 * cloudSize);

  ellipse(
    x - 45 * cloudSize,
    y + 8 * cloudSize,
    75 * cloudSize,
    40 * cloudSize
  );

  ellipse(
    x + 45 * cloudSize,
    y + 7 * cloudSize,
    80 * cloudSize,
    42 * cloudSize
  );

  ellipse(
    x - 18 * cloudSize,
    y - 23 * cloudSize,
    73 * cloudSize,
    65 * cloudSize
  );

  ellipse(
    x + 28 * cloudSize,
    y - 16 * cloudSize,
    66 * cloudSize,
    55 * cloudSize
  );
}


// =====================================
// LANDSCAPE
// =====================================

void drawLandscape() {
  noStroke();

  // Mountains
  fill(92, 155, 130);

  beginShape();

  vertex(0, 430);
  vertex(150, 325);
  vertex(275, 430);
  vertex(430, 290);
  vertex(610, 430);
  vertex(800, 310);
  vertex(1100, 430);
  vertex(1100, 520);
  vertex(0, 520);

  endShape(CLOSE);

  // Green hills
  fill(75, 176, 99);

  ellipse(130, 480, 440, 175);
  ellipse(520, 490, 570, 165);
  ellipse(960, 475, 510, 180);

  // Main grass field
  fill(39, 151, 73);
  rect(0, 455, width, 245);

  // Lighter grass area
  fill(51, 166, 78);
  rect(0, 455, width, 42);

  // Background trees
  for (int x = 25; x < width; x += 75) {
    float treeY = 450 + int(noise(x) * 25);

    drawTree(x, treeY, 0.55);
  }
}


// =====================================
// TREES
// =====================================

void drawTree(float x, float y, float treeSize) {
  noStroke();

  // Tree trunk
  fill(90, 65, 40);

  rect(
    x - 4 * treeSize,
    y,
    8 * treeSize,
    35 * treeSize
  );

  // Dark leaves
  fill(25, 112, 58);

  ellipse(
    x,
    y - 8 * treeSize,
    48 * treeSize,
    55 * treeSize
  );

  // Light leaves
  fill(42, 143, 69);

  ellipse(
    x - 12 * treeSize,
    y + 2 * treeSize,
    33 * treeSize,
    38 * treeSize
  );
}


// =====================================
// SECURITY FENCE
// =====================================

void drawFence() {
  stroke(180, 190, 190);
  strokeWeight(2);

  for (int x = 0; x < width; x += 45) {
    line(x, 480, x, 535);
  }

  line(0, 492, width, 492);
  line(0, 520, width, 520);

  noStroke();
}


// =====================================
// SERVICE ROAD
// =====================================

void drawRoad() {
  noStroke();

  fill(74, 80, 84);

  quad(
    0, 625,
    0, 700,
    455, 700,
    505, 560
  );

  // Yellow road line
  stroke(245, 206, 55);
  strokeWeight(5);
  line(20, 670, 432, 670);

  noStroke();
}


// =====================================
// SQUARE CONTROL ROOM
// =====================================

void drawControlRoom() {
  noStroke();

  // Building shadow
  fill(25, 80, 55, 70);
  ellipse(185, 628, 275, 32);

  // Main square building
  fill(225, 232, 230);
  rect(58, 505, 265, 120, 7);

  // Thick flat roof
  fill(54, 68, 76);
  rect(48, 490, 285, 30, 6);

  // Orange safety line
  fill(243, 151, 37);
  rect(48, 515, 285, 7);

  // Control Room name
  fill(255);
  textAlign(LEFT, CENTER);
  textSize(16);
  text("CONTROL ROOM", 72, 505);

  // Three observation windows
  for (int x = 78; x <= 202; x += 62) {
    fill(50, 145, 190);
    rect(x, 545, 48, 42, 4);

    // Window reflection
    fill(148, 215, 238, 140);

    triangle(
      x + 4, 549,
      x + 23, 549,
      x + 4, 568
    );
  }

  // Entrance door
  fill(55, 70, 78);
  rect(267, 543, 39, 82, 4, 4, 0, 0);

  // Door handle
  fill(235, 190, 70);
  ellipse(296, 584, 5, 5);

  // Front step
  fill(125, 132, 134);
  rect(258, 620, 57, 7, 2);

  // Roof equipment
  fill(125, 134, 138);
  rect(82, 477, 62, 13, 3);

  // Antenna pole
  stroke(70);
  strokeWeight(3);
  line(234, 490, 234, 455);

  // Antenna receiver
  noFill();
  arc(234, 458, 42, 27, PI, TWO_PI);

  // Red antenna light
  noStroke();
  fill(235, 55, 48);
  ellipse(234, 450, 8, 8);

  noStroke();
}


// =====================================
// LAUNCH TOWER
// =====================================

void drawLaunchTower() {
  stroke(72, 78, 83);
  strokeWeight(7);

  // Tower supports
  line(745, 515, 745, 245);
  line(815, 515, 815, 245);

  // Cross supports
  strokeWeight(3);

  for (int y = 265; y < 510; y += 38) {
    line(745, y, 815, y + 38);
    line(815, y, 745, y + 38);
    line(745, y, 815, y);
  }

  // Tower top
  fill(92, 99, 104);
  noStroke();
  rect(733, 230, 94, 22, 3);

  // Yellow safety strip
  fill(245, 170, 35);
  rect(733, 230, 94, 6, 3);

  // Blinking warning lights
  if ((frameCount / 30) % 2 == 0) {
    fill(255, 55, 45);
  } else {
    fill(115, 25, 20);
  }

  ellipse(744, 225, 9, 9);
  ellipse(816, 225, 9, 9);
}


// =====================================
// LAUNCH PLATFORM
// =====================================

void drawLaunchPad() {
  noStroke();

  // Platform shadow
  fill(40, 95, 60, 75);
  ellipse(790, 640, 460, 55);

  // Concrete platform
  fill(96, 102, 107);

  quad(
    595, 550,
    960, 550,
    1050, 700,
    500, 700
  );

  // Outer launch circle
  fill(172, 179, 182);
  ellipse(780, 557, 330, 78);

  // Inner launch circle
  fill(75, 81, 86);
  ellipse(780, 557, 250, 49);

  // Yellow safety circle
  noFill();
  stroke(247, 198, 42);
  strokeWeight(6);
  ellipse(780, 557, 290, 64);

  noStroke();
}


// =====================================
// WINDSOCK
// =====================================

void drawWindSock() {
  float windMovement = wind * 18;

  // Windsock pole
  stroke(75);
  strokeWeight(5);

  line(390, 560, 390, 440);
  line(390, 440, 406, 440);

  noStroke();

  // Orange section
  fill(245, 90, 45);

  quad(
    405, 433,
    455 + windMovement, 440,
    455 + windMovement, 455,
    405, 449
  );

  // White stripe
  fill(255);

  quad(
    422, 436,
    437, 438,
    437, 453,
    422, 451
  );
}


// =====================================
// MOVING GRASS
// =====================================

void drawGrass() {
  strokeWeight(2);

  for (int x = 3; x < width; x += 8) {

    // Avoid drawing grass on the launch platform
    if (x > 480) {
      continue;
    }

    float grassHeight =
      10 + noise(x * 0.08) * 18;

    float grassMovement =
      sin(frameCount * 0.04 + x * 0.05) * 5 * wind;

    // Dark grass blade
    stroke(16, 111, 49);

    line(
      x,
      695,
      x + grassMovement,
      695 - grassHeight
    );

    // Light grass blade
    stroke(87, 203, 90);

    line(
      x + 3,
      700,
      x + 3 + grassMovement,
      700 - grassHeight * 0.75
    );
  }

  noStroke();
}


// =====================================
// GAME INFORMATION
// =====================================

void drawInterface() {
  // Main title
  fill(14, 43, 64, 215);
  rect(22, 20, 355, 70, 12);

