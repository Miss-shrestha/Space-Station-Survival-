  text("EARTH LAUNCH COMPLEX", 43, 48);

  fill(115, 225, 170);
  textSize(12);
  text("MARS MISSION - SYSTEMS ONLINE", 45, 75);

  // Wind information
  fill(14, 43, 64, 205);
  rect(875, 625, 200, 52, 10);

  fill(255);
  textSize(13);
  text("WIND", 892, 644);

  // Wind strength bar
  fill(130, 220, 255);
  rect(940, 638, wind * 72, 10, 5);

  fill(195, 225, 235);
  text("Launch conditions monitored", 892, 662);
